@model dynamic

<h2>Your Bank Account</h2>

@if (Model == null)
{
    <p>You do not have an account yet.</p>

    <button class="btn btn-success me-2" onclick="showBox('cheq')">Create Chequing Account</button>
    <button class="btn btn-primary" onclick="showBox('save')">Create Savings Account</button>

    <div id="cheqBox" style="display:none;" class="mt-3">
        <form asp-action="CreateChequing" method="post">
            <label>Starting Balance:</label>
            <input type="number" name="balance" step="0.01" required class="form-control" />
            <button type="submit" class="btn btn-success mt-2">Confirm</button>
        </form>
    </div>

    <div id="saveBox" style="display:none;" class="mt-3">
        <form asp-action="CreateSavings" method="post">
            <label>Starting Balance:</label>
            <input type="number" name="balance" step="0.01" required class="form-control" />
            <button type="submit" class="btn btn-primary mt-2">Confirm</button>
        </form>
    </div>

    <script>
        function showBox(type) {
            document.getElementById("cheqBox").style.display = "none";
            document.getElementById("saveBox").style.display = "none";

            if (type === 'cheq')
                document.getElementById("cheqBox").style.display = "block";
            else
                document.getElementById("saveBox").style.display = "block";
        }
    </script>
}
else
{
    <!-- shared account -->
    <p><strong>Account Type:</strong> @Model.Account?.AccountType</p>
    <p><strong>Balance:</strong> @Model.Balance</p>

    @* Savings interest display *@
    @if (Model.Account?.AccountType == InvestmentApp.Models.AccountType.Savings)
    {
        <p class="text-success">
            <strong>End-of-Year Interest (1.25%):</strong> @ViewBag.Interest.ToString("C")
        </p>
    }

    <hr />

    <!-- add funds -->
    <button class="btn btn-primary" onclick="toggleFunds()">Add Funds</button>

    <div id="fundsBox" style="display:none;" class="mt-3">
        <form asp-action="AddFunds" method="post">
            <label>Add Amount:</label>
            <input type="number" name="amount" step="0.01" class="form-control" required />
            <button type="submit" class="btn btn-success mt-2">Confirm</button>
        </form>
    </div>

    <script>
        function toggleFunds() {
            var box = document.getElementById("fundsBox");
            box.style.display = box.style.display === "none" ? "block" : "none";
        }
    </script>

    <hr />

    <!-- delete -->
    <form asp-action="DeleteAccount" method="post">
        <button class="btn btn-danger mt-3">Delete Account</button>
    </form>

    <br />

    <a asp-controller="Portfolio" asp-action="Index" asp-route-userId="@Model.UserId">Manage Portfolios</a>
    <a asp-controller="Stock" asp-action="Index" asp-route-userId="@Model.UserId">Manage Stocks</a>
}
