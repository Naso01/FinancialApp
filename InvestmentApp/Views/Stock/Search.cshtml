@model List<InvestmentApp.Models.Stock>
@{
    /***************************************************************************************
         * Author: Keegan Erdis
         * Description:
         *     Razor view for searching and purchasing stocks within the InvestmentApp
         *     system. The view provides:
         *
         *       • A search form for users to enter stock symbols or company names
         *       • Displays search results returned from the StockController via Finnhub API
         *       • Shows stock symbol, company name, and current price for each result
         *       • Buy forms for users to purchase stocks directly into their first portfolio
         *       • Integration with the 30-day stock price chart functionality
         *
         *     The view expects:
         *       - A model of type List<Stock> representing the stocks found in the search
         *       - ViewBag.User to identify the current logged-in user
         *       - ViewBag.Results to display the stocks returned from the search
         *
         *     This page is tightly integrated with StockController actions:
         *       - Search (GET/POST) for querying stocks
         *       - BuyFromSearch for purchasing stocks
         *       - Chart for rendering historical stock data
         ***************************************************************************************/

}
@{
    var user = ViewBag.User as InvestmentApp.Models.User;
    var results = ViewBag.Results as List<InvestmentApp.Models.Stock>;
}

<h2>Search Stocks</h2>

<form method="post" asp-action="Search">
    @Html.AntiForgeryToken()
    <div class="mb-2">
        <input type="text" name="query" placeholder="Enter stock symbol or name" class="form-control" />
    </div>
    @if (user != null)
    {
        <input type="hidden" name="userId" value="@user.UserId" />
        
    }
    <button type="submit" class="btn btn-primary">Search</button>

</form>

@if (results != null && results.Count > 0)
{
    <h3 class="mt-3">Results</h3>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>Company</th>
                <th>Price</th>
                <th>Buy</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stock in results)
            {
                <tr>
                    <td>@stock.Symbol</td>
                    <td>@stock.CompanyName</td>
                    <td>@stock.Price</td>
                    <td>
                        <form asp-action="BuyFromSearch" method="post">
                            <input type="hidden" name="userId" value="@user.UserId" />
                            <input type="hidden" name="portfolioId" value="@user.Portfolios.First().PortfolioId" />
                            <input type="hidden" name="symbol" value="@stock.Symbol" />
                            <input type="number" step="0.01" min="0" name="quantity" class="form-control" style="width:100px; display:inline;" />
                            <button type="submit" class="btn btn-success btn-sm">Buy</button>
                        </form>

                        <!-- Add chart button here -->
                        <a class="btn btn-outline-primary btn-sm mt-1"
                           asp-controller="Stock"
                           asp-action="Chart"
                           asp-route-symbol="@stock.Symbol">
                            View 30-Day Chart
                        </a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
}
