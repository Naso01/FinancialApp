@model Dictionary<InvestmentApp.Models.Portfolio, List<(InvestmentApp.Models.PortfolioHolding holding, InvestmentApp.Models.Stock stock)>>
@{
    /***************************************************************************************
         * Author: Keegan Erdis
         * Description:
         *     Razor view responsible for displaying a user's investment portfolios in the
         *     InvestmentApp system. The view provides:
         *
         *       • Portfolio overview including portfolio type and creation date
         *       • Holdings with live stock prices, average purchase price, and current value
         *       • Forms to sell existing holdings with quantity validation
         *       • Forms to buy new stocks from the available stock list
         *       • Transaction feedback via TempData (success or error messages)
         *       • Quick navigation to the stock search page for additional purchases
         *
         *     This view is tightly coupled to the StockController and expects a model of
         *     type Dictionary<Portfolio, List<(PortfolioHolding holding, Stock stock)>>,
         *     along with ViewBag properties for the current user and all stocks.
         ***************************************************************************************/
}
@{
    var user = ViewBag.User as InvestmentApp.Models.User;
    var allStocks = ViewBag.AllStocks as List<InvestmentApp.Models.Stock>;
} 

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        <strong>Transaction Failed:</strong> @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}

<h2>Portfolios</h2>
<p><strong>User:</strong> @user.FirstName @user.LastName</p>
<p><strong>Balance:</strong> @user.ChequingAccount.Balance.ToString("C")</p>

@foreach (var portfolioEntry in Model)
{
    var portfolio = portfolioEntry.Key;
    var holdingsWithPrices = portfolioEntry.Value;

    <h3>@portfolio.PortfolioType Portfolio (Created: @portfolio.CreatedAt.ToShortDateString())</h3>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Stock</th>
                <th>Symbol</th>
                <th>Quantity</th>
                <th>Avg Price</th>
                <th>Current Price</th>
                <th>Value</th>
                <th>Sell</th>
            </tr>
        </thead>
        <tbody>
            @if (!holdingsWithPrices.Any())
            {
                <tr>
                    <td colspan="7" class="text-center">No holdings yet.</td>
                </tr>
            }
            else
            {
                foreach (var (holding, stock) in holdingsWithPrices)
                {
                    <tr>
                        <td>@stock.CompanyName</td>
                        <td>@stock.Symbol</td>
                        <td>@holding.Quantity</td>
                        <td>@holding.AvgPrice.ToString("C")</td>
                        <td>@stock.Price.ToString("C")</td>
                        <td>@(holding.Quantity * stock.Price)</td>
                        <td>
                            <form asp-action="SellStock" method="post">
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <input type="hidden" name="portfolioId" value="@portfolio.PortfolioId" />
                                <input type="hidden" name="stockId" value="@holding.StockId" />
                                <input type="number" name="quantity" step="0.01" min="0" class="form-control mb-1" />
                                <button type="submit" class="btn btn-danger btn-sm w-100">Sell</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <h4>Buy New Stock</h4>
    <form asp-action="BuyStock" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@user.UserId" />
        <input type="hidden" name="portfolioId" value="@portfolio.PortfolioId" />
        <div class="mb-2">
            <label>Stock:</label>
            <select name="stockId" class="form-select">
                @foreach (var s in allStocks)
                {
                    <option value="@s.StockId">@s.Symbol - @s.CompanyName</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label>Quantity:</label>
            <input type="number" step="0.01" min="0" name="quantity" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Buy</button>
    </form>
    <hr />

    <p>
        <a class="btn btn-primary" asp-controller="Stock" asp-action="Search">
            Search Stocks
        </a>
    </p>
}
