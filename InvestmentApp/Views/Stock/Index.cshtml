@model Dictionary<InvestmentApp.Models.Portfolio, List<(InvestmentApp.Models.PortfolioHolding holding, InvestmentApp.Models.Stock stock)>>

@{
    var user = ViewBag.User as InvestmentApp.Models.User;
    var allStocks = ViewBag.AllStocks as List<InvestmentApp.Models.Stock>;
}

<h2>Portfolios</h2>
<p><strong>User:</strong> @user.FirstName @user.LastName</p>
<p><strong>Balance:</strong> @user.ChequingAccount.Balance</p>

@foreach (var portfolioEntry in Model)
{
    var portfolio = portfolioEntry.Key;
    var holdingsWithPrices = portfolioEntry.Value;

    <h3>@portfolio.PortfolioType Portfolio (Created: @portfolio.CreatedAt.ToShortDateString())</h3>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Stock</th>
                <th>Symbol</th>
                <th>Quantity</th>
                <th>Avg Price</th>
                <th>Current Price</th>
                <th>Value</th>
                <th>Sell</th>
            </tr>
        </thead>
        <tbody>
            @if (holdingsWithPrices.Count == 0)
            {
                <tr>
                    <td colspan="7">No holdings yet.</td>
                </tr>
            }
            else
            {
                foreach (var (holding, stock) in holdingsWithPrices)
                {
                    <tr>
                        <td>@stock.CompanyName</td>
                        <td>@stock.Symbol</td>
                        <td>@holding.Quantity</td>
                        <td>@holding.AvgPrice</td>
                        <td>@stock.Price</td>
                        <td>@(holding.Quantity * stock.Price)</td>
                        <td>
                            <form asp-action="SellStock" method="post">
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <input type="hidden" name="portfolioId" value="@portfolio.PortfolioId" />
                                <input type="hidden" name="stockId" value="@holding.StockId" />
                                <input type="number" name="quantity" step="0.01" min="0" />
                                <button type="submit" class="btn btn-danger btn-sm">Sell</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <h4>Buy New Stock</h4>
    <form asp-action="BuyStock" method="post">
        <input type="hidden" name="userId" value="@user.UserId" />
        <input type="hidden" name="portfolioId" value="@portfolio.PortfolioId" />
        <div class="mb-2">
            <label>Stock:</label>
            <select name="stockId" class="form-select">
                @foreach (var s in allStocks)
                {
                    <option value="@s.StockId">@s.Symbol - @s.CompanyName</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label>Quantity:</label>
            <input type="number" step="0.01" min="0" name="quantity" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Buy</button>
    </form>
    <hr />
}
