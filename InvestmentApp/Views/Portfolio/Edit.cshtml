@*
    ***************************************************************************************
     Author: Hanjia Li
     Description:
         This view allows a user to edit an existing portfolio. It provides options to:
           - Change the portfolio type (Managed or Self-Directed)
           - Add funds to the portfolio from the user's chequing account
         
         The form posts back to the PortfolioController.Edit action with the updated data.
    ***************************************************************************************
*@
<h2>Edit Portfolio</h2>

<form method="post" asp-action="Edit">
    <input type="hidden" name="id" value="@Model.PortfolioId" />

    <div class="form-group mt-3">
        <label>Portfolio Type</label>
        <select name="type" class="form-control">
            <option value="0" selected="@(Model.PortfolioType == PortfolioType.Managed)">Managed</option>
            <option value="1" selected="@(Model.PortfolioType == PortfolioType.SelfDirected)">Self Directed</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Add Funds (from Chequing)</label>
        <input name="amount" type="number" step="0.01" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success mt-3">Save Changes</button>
</form>
