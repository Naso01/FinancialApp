@*
    ***************************************************************************************
     Author: Hanjia Li
     Description:
         This view allows a user to create a new portfolio. It includes:
           - A form to enter the portfolio name
           - A selection between Self-Directed or Managed portfolio types
           - Error display for invalid/duplicate portfolio creation attempts
         
         The form posts back to PortfolioController.Create with the user's ID.
    ***************************************************************************************
*@
@{
    int userId = ViewBag.UserId;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form method="post" asp-action="Create" asp-route-userId="@userId">
    <div class="form-group mb-3">
        <label>Name</label>
        <input name="name" class="form-control" placeholder="Enter portfolio name" required />
    </div>

    <div class="form-group mb-3">
        <label>Portfolio Type</label>
        <div class="form-group mb-3" id="depositContainer" style="display:none;">
            <label>Initial Deposit</label>
            <input type="number" step="0.01" name="initialDeposit" class="form-control" />
        </div>

        <script>
            const typeSelect = document.getElementById("type");
            const depositDiv = document.getElementById("depositContainer");

            typeSelect.addEventListener("change", () => {
                depositDiv.style.display = typeSelect.value === "1" ? "block" : "none";
            });
        </script>
        <select id="type" name="type" class="form-select">
            <option value="0">Self-Directed</option>
            <option value="1">Managed</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>
