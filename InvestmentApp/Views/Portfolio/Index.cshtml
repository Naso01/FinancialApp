@*
    ***************************************************************************************
     Author: Hanjia Li
     Description:
         This view displays all portfolios belonging to a specific user. It allows the user
         to:
           - View portfolio name, type, and creation date
           - Create a new portfolio
           - Navigate to stock search for a selected portfolio
           - Edit an existing portfolio
           - Delete a portfolio
         
         Data is passed from the PortfolioController using a List<Portfolio> model and
         userId is provided through ViewBag.
    ***************************************************************************************
*@
@model List<InvestmentApp.Models.Portfolio>

@{
    int userId = ViewBag.UserId;
}

<h2>Your Portfolios</h2>

<a class="btn btn-primary mb-3"
   asp-controller="Portfolio"
   asp-action="Create"
   asp-route-userId="@userId">
    Add Portfolio
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var p in Model)
{
    <tr>
        <td>@(string.IsNullOrEmpty(p.Name) ? "(Unnamed Portfolio)" : p.Name)</td>

        <td>
            @(p.PortfolioType == PortfolioType.Managed ? "Managed" : "Self-Directed")
        </td>

        <td>@p.CreatedAt.ToShortDateString()</td>

        <td>
            <a class="btn btn-info btn-sm"
               asp-controller="Stock"
               asp-action="Index"
               asp-route-userId="@ViewBag.UserId"
               asp-route-portfolioId="@p.PortfolioId">
                Search Stocks
            </a>

            <a class="btn btn-warning btn-sm"
               asp-action="Edit"
               asp-route-id="@p.PortfolioId">
                Edit
            </a>

            <a class="btn btn-danger btn-sm"
               asp-action="Delete"
               asp-route-id="@p.PortfolioId">
                Delete
            </a>
        </td>
    </tr>
}
    </tbody>
</table>
