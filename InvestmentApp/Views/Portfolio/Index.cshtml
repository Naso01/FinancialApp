@model List<InvestmentApp.Models.Portfolio>

@{
    int userId = ViewBag.UserId;  // <── pull it once at the top
}

<h2>Your Portfolios</h2>

<a class="btn btn-primary mb-3"
   asp-controller="Portfolio"
   asp-action="Create"
   asp-route-userId="@userId">
    Add Portfolio
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var p in Model)
{
    <tr>
        <td>@(string.IsNullOrEmpty(p.Name) ? "(Unnamed Portfolio)" : p.Name)</td>

        <td>
            @(p.PortfolioType == PortfolioType.Managed ? "Managed" : "Self-Directed")
        </td>

        <td>@p.CreatedAt.ToShortDateString()</td>

        <td>
            <a class="btn btn-info btn-sm"
               asp-controller="Stock"
               asp-action="Index"
               asp-route-userId="@ViewBag.UserId"
               asp-route-portfolioId="@p.PortfolioId">
                Search Stocks
            </a>

            <a class="btn btn-warning btn-sm"
               asp-action="Edit"
               asp-route-id="@p.PortfolioId">
                Edit
            </a>

            <a class="btn btn-danger btn-sm"
               asp-action="Delete"
               asp-route-id="@p.PortfolioId">
                Delete
            </a>
        </td>
    </tr>
}
</tbody>

</table>
