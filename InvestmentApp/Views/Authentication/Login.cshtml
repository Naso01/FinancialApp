@*
    ***************************************************************************************
     Author: Nathan Serrano
     Description:
         This view displays the login form used to authenticate users into the system.
         It collects the user’s email and password, displays validation errors, and
         posts the input to the AuthenticationController’s Login action.
    ***************************************************************************************
*@

@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>

    if (ViewBag.ShowSignup == true)
    {
        <a asp-controller="Authentication"
           asp-action="SignUp"
           class="btn btn-secondary">
            Create an Account
        </a>
    }
}


<form method="post" asp-controller="Authentication" asp-action="Login">
    <div class="form-group">
        <label>Email</label>
        <input name="username" class="form-control" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input name="password" type="password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Login</button>
</form>
