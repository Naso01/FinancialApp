@*
    ***************************************************************************************
     Author: Nathan Serrano
     Description:
         This view displays the form for creating a new user account. It collects the
         user’s personal information (first name, last name, email, password) and posts
         it to the AuthenticationController’s SignUp action. Errors are shown if the user
         attempts to register with an already existing email or invalid inputs.
    ***************************************************************************************
*@

@{
    ViewData["Title"] = "SignUp";
}

<h2>Create an Account</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="post">
    <div class="mb-3">
        <label>First Name</label>
        <input name="firstName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Last Name</label>
        <input name="lastName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <input name="email" class="form-control" type="email" required />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <input name="password" class="form-control" type="password" required />
    </div>

    <button class="btn btn-primary">Sign Up</button>

    <a asp-action="SignUp" asp-controller="Authentication" class="btn btn-link">Back to Login</a>
</form>
